  "strings": {
    "": {},
    "%@ %@": {
      "comment": "Chat timestamp, other year: time month/day/year",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@"
          }
        }
      }
    },
    "%@ ago": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@前"
          }
        }
      }
    },
    "%@ leads this chat: your messages go to it, and it hands work to the other Bots. Write @Name to reach a Bot directly.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 负责这个群聊：你的消息先交给它，由它把工作分派给其他 Bot。要直接找某个 Bot，请写 @名字。"
          }
        }
      }
    },
    "%@ · %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ · %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@"
          }
        }
      }
    },
    "%@, %@": {
      "comment": "Chat timestamp, same year: time, month/day",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$@"
          }
        }
      }
    },
