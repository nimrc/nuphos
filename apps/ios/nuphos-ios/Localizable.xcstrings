    "00000000-0000-0000-0000-000000000000": {},
    "1. Add this account to your authenticator app": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1. 将此账户添加到验证器应用"
          }
        }
      }
    },
    "1. Copy this code.\n2. Open the sign-in page and sign in with your %@ account.\n3. Enter the code when asked. This page updates once you're signed in.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1. 复制此验证码。\n2. 打开登录页，用你的 %@ 账户登录。\n3. 按提示输入验证码。登录成功后此页面会自动更新。"
          }
        }
      }
    },
    "2 days ago %@": {
      "comment": "Chat timestamp, two days back",
      "localizations": {
